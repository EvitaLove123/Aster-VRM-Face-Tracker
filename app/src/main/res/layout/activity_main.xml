<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ASTER VRM FACE TRACKER"
            android:textColor="#24466D"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Camera permission required"
            android:textColor="#52677F"
            android:textSize="14sp" />
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="16dp"
            android:background="#DDEBFA" />
        <TextView
            android:id="@+id/faceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Face: waiting"
            android:textColor="#24466D"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/trackingValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Eyes: --&#10;Mouth: --&#10;Brows: --&#10;Head: --"
            android:textColor="#334A63"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Prototype 0.1 · Live face landmarks and blendshape scores. VRM avatar preview and expression mapping are the next integration stage."
            android:textColor="#6B7F95"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
