<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F9FF" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ASTER VRM FACE TRACKER" android:textColor="#24466D" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Starting face tracker..." android:textColor="#52677F" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="VRM AVATAR PREVIEW" android:textColor="#24466D" android:textStyle="bold" android:textSize="14sp"/>
<WebView android:id="@+id/vrmWebView" android:layout_width="match_parent" android:layout_height="390dp" android:layout_marginTop="8dp" android:background="#EAF3FF"/>
<TextView android:id="@+id/vrmStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Choose a .vrm file in the preview to load your avatar." android:textColor="#52677F" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="FRONT CAMERA" android:textColor="#24466D" android:textStyle="bold" android:textSize="14sp"/>
<androidx.camera.view.PreviewView android:id="@+id/cameraPreview" android:layout_width="match_parent" android:layout_height="270dp" android:layout_marginTop="8dp" android:background="#DDEBFA"/>
<TextView android:id="@+id/faceState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#FFFFFF" android:padding="12dp" android:text="Face: waiting" android:textColor="#24466D" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/trackingValues" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#FFFFFF" android:padding="12dp" android:text="Eyes: --&#10;Mouth: --&#10;Brows: --&#10;Head: --" android:textColor="#334A63" android:textSize="13sp" android:lineSpacingExtra="5dp"/>
</LinearLayout></ScrollView>